# Copy to .env (which is git-ignored) and fill in from the Neon dashboard -> Connect.
# App uses the POOLED string (host has "-pooler"):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Alembic uses the DIRECT string (same, but without "-pooler"):
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars


# ---- Speaking assessment (FR-5) ----
# By default the speech models run in the cloud for free, so nothing heavy runs on your PC.
# Each teammate should use their own keys: free limits are per account.

# Speech-to-text (Groq, free, no card): https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# Pronunciation (our Hugging Face ZeroGPU Space, free: 5 GPU-minutes a day per account,
# roughly 60-100 answers). Token: https://huggingface.co/settings/tokens -> Create new token
# -> type "Write" (needed once to deploy the Space; a "Read" token is enough afterwards).
HF_TOKEN=
# The Space to call, as owner/name, e.g. your-username/cadence-speech. One teammate deploys it
# (see README); everyone else puts the same name here and uses their own HF_TOKEN.
HF_SPEECH_SPACE=

# Run everything on this machine instead (offline; ~3 GB of downloads and heavy CPU use).
# Needs the extra packages listed at the bottom of requirements.txt.
# SPEECH_MODE=local
# SPEECH_STT_MODEL=large-v3-turbo

# Examiner-style feedback from Claude (paid API). Leave empty to use the built-in feedback.
# ANTHROPIC_API_KEY=
