# Copy to .env (which is git-ignored) and fill in from the Neon dashboard -> Connect.
# App uses the POOLED string (host has "-pooler"):
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Alembic uses the DIRECT string (same, but without "-pooler"):
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Secret used to sign login tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
